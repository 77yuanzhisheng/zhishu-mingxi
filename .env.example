# ============================================
# 知数·明析 环境配置
# ============================================

# --- 嵌入模型配置 ---
# 可选值: bge-large-zh-v1.5 (推荐) / bge-m3 / all-MiniLM-L6-v2
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# 嵌入后端: sentence_transformers (本地) / openai (远程API)
EMBEDDING_BACKEND=sentence_transformers
# 嵌入模型运行设备: cpu / cuda
EMBEDDING_DEVICE=cpu

# --- ChromaDB 配置 ---
CHROMA_PERSIST_DIR=./data/chroma

# --- 星火 MaaS LLM API 配置 ---
# 比赛主线使用星火 MaaS 发布的 Qwen3-32B 文本模型和 Qwen3-VL-32B 视觉模型。
LLM_PROVIDER=spark
SPARK_BASE_URL=https://maas-api.cn-huabei-1.xf-yun.com/v2
SPARK_API_KEY=
SPARK_MODEL=xop3qwen32b
SPARK_VL_BASE_URL=https://maas-api.cn-huabei-1.xf-yun.com/v2
SPARK_VL_API_KEY=
SPARK_VL_MODEL=xop3qwen32bvl
# 单次 LLM 请求超时秒数
LLM_TIMEOUT_SECONDS=60
# 瞬时超时或 5xx 的额外重试次数（0-4）
LLM_MAX_RETRIES=2
# 最长回复 token 数
LLM_MAX_TOKENS=768
# Maximum characters retained from conversation history before calling the model.
LLM_MAX_INPUT_CHARS=12000
# 生产默认关闭思考模式，由任务级 prompt 控制证明题输出长度
LLM_ENABLE_THINKING=false

# 已发布服务元数据（非密钥，可提交）
# Resource ID: 2096508959127535616
# API Key 必须只在本地 .env 配置，禁止提交。

# --- OpenAI 兼容回退服务（可选） ---
# 当星火 MaaS 主服务暂时不可用时，已配置的回退服务会自动接管。
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_CHAT_MODEL=

# --- 队员五：微调前后 112 题对比评测 ---
# 三组端点均兼容 OpenAI /chat/completions；裁判模型必须固定且独立。
BASELINE_BASE_URL=https://api.siliconflow.cn/v1
BASELINE_MODEL=Qwen/Qwen3-8B
BASELINE_API_KEY=
TUNED_BASE_URL=
TUNED_MODEL=
TUNED_API_KEY=
JUDGE_BASE_URL=https://api.siliconflow.cn/v1
JUDGE_MODEL=
JUDGE_API_KEY=

# --- 讯飞星辰 Agent 主通道 ---
XINGCHEN_AGENT_ENABLED=true
XINGCHEN_API_URL=https://xingchen-api.xf-yun.com/workflow/v1/chat/completions
XINGCHEN_API_KEY=
XINGCHEN_API_SECRET=
XINGCHEN_FLOW_ID=
XINGCHEN_BOT_ID=workflow
XINGCHEN_TIMEOUT=120
XINGCHEN_DEBUG=false

# --- 服务配置 ---
API_HOST=127.0.0.1
API_PORT=8000
API_RELOAD=true

# --- 账户认证配置 ---
# 生产环境请设置为足够长的随机字符串，禁止使用示例值。
AUTH_JWT_SECRET=
AUTH_JWT_EXPIRE_MINUTES=1440
