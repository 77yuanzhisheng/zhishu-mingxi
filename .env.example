# ============================================
# 知数·明析 环境配置
# ============================================

# --- 嵌入模型配置 ---
# 可选值: bge-large-zh-v1.5 (推荐) / bge-m3 / all-MiniLM-L6-v2
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# 嵌入后端: sentence_transformers (本地) / openai (远程API)
EMBEDDING_BACKEND=sentence_transformers
# 嵌入模型运行设备: cpu / cuda
EMBEDDING_DEVICE=cpu

# --- ChromaDB 配置 ---
CHROMA_PERSIST_DIR=./data/chroma

# --- LLM API 配置（SiliconFlow，与 .env 保持一致） ---
SILICONFLOW_API_KEY=your_siliconflow_api_key_here
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.siliconflow.cn/v1
# OpenAI 兼容接口实际提供的聊天模型名（例如 Qwen/Qwen3-8B）
OPENAI_CHAT_MODEL=Qwen/Qwen3-8B
# 单次 LLM 请求超时秒数（四色定理等复杂题需要 ≥300，勿调回 60）
LLM_TIMEOUT_SECONDS=300
# 瞬时超时或 5xx 的额外重试次数（0-4）
LLM_MAX_RETRIES=2
# 最长回复 token 数
OPENAI_MAX_TOKENS=800
# SiliconFlow Qwen3 推理模型必须关闭思考（否则复杂题会 read timeout）
OPENAI_ENABLE_THINKING=false

# --- 备用 LLM（讯飞星火 · 赛事推荐平台） ---
# SPARK_API_KEY 留空 = 不启用；填入星火开放平台 APIPassword 后，
# 主通道失败会自动切换到星火（OpenAI 兼容接口，无需改代码）。
# 控制台: https://console.xfyun.cn（服务接口认证 -> APIPassword）
SPARK_API_KEY=
SPARK_BASE_URL=https://spark-api-open.xf-yun.com/v1
SPARK_CHAT_MODEL=4.0Ultra

# --- 服务配置 ---
API_HOST=127.0.0.1
API_PORT=8000
API_RELOAD=true

# --- 账户认证配置 ---
# 生产环境请设置为足够长的随机字符串，禁止使用示例值。
AUTH_JWT_SECRET=
AUTH_JWT_EXPIRE_MINUTES=1440
