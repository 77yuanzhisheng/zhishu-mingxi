# ============================================
# 知数·明析 环境配置
# ============================================

# --- 嵌入模型配置 ---
# 可选值: bge-large-zh-v1.5 (推荐) / bge-m3 / all-MiniLM-L6-v2
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# 嵌入后端: sentence_transformers (本地) / openai (远程API)
EMBEDDING_BACKEND=sentence_transformers
# 嵌入模型运行设备: cpu / cuda
EMBEDDING_DEVICE=cpu

# --- ChromaDB 配置 ---
CHROMA_PERSIST_DIR=./data/chroma

# --- LLM API 配置（队员1提供） ---
SILICONFLOW_API_KEY=your_siliconflow_api_key_here
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=http://localhost:11434/v1
# OpenAI 兼容接口实际提供的聊天模型名（例如本地 Qwen 服务中的模型 ID）
OPENAI_CHAT_MODEL=
# 单次 LLM 请求超时秒数
LLM_TIMEOUT_SECONDS=60
# 最长回复 token 数
OPENAI_MAX_TOKENS=1024
# SiliconFlow Qwen3 等支持该参数；留空时不发送供应商扩展字段
OPENAI_ENABLE_THINKING=

# --- 服务配置 ---
API_HOST=127.0.0.1
API_PORT=8000
API_RELOAD=true
