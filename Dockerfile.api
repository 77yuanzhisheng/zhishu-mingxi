# syntax=docker/dockerfile:1
FROM python:3.11-slim
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PIP_NO_CACHE_DIR=1
WORKDIR /app
RUN useradd --create-home --uid 10001 appuser
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
COPY backend ./backend
COPY algorithm_tools ./algorithm_tools
COPY data/documents ./data/documents
COPY data/teacher_kg.json ./data/teacher_kg.json
COPY data/mapping_v1.json ./data/mapping_v1.json
COPY data/mapping_v2.json ./data/mapping_v2.json
COPY main.py ./
RUN mkdir -p /app/data/chroma /app/data && chown -R appuser:appuser /app
USER 10001
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=120s --retries=3 CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/api/health', timeout=3)"
CMD ["uvicorn", "backend.api:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--no-access-log"]
