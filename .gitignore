# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/

# 环境配置（含API Key，不提交）
.env

# 向量数据库（自动重建）
data/chroma/
data/chroma_bge_small/

# 学情分析运行时数据库（首次启动自动创建）
data/learning.db

# 大文件（模型92MB，单独分发）
local_models/

# IDE
.idea/
.vscode/
*.swp

# 临时文件
temp_*/
*.tmp

# 服务运行产物（watchdog 日志与 pid）
scripts/*.log
scripts/*.pid

# 文档输出
*.docx

# Local calibration checks and their SQLite databases
.grading-*/

# Local Git worktrees used for isolated feature development
.worktrees/

